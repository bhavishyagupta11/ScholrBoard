# ==============================================================================
# ScholrBoard Docker Environment Configuration
# ==============================================================================

# ─── CORE SERVER CONFIGURATION ────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── DATABASE CONFIGURATION ───────────────────────────────────────────────────
# Internal Docker MongoDB container connection (with rs0 single-node replica set for ACID transactions)
MONGODB_URI=mongodb://mongodb:27017/scholrboard?replicaSet=rs0&directConnection=true

# If using external MongoDB Atlas instead of local container, specify your Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/scholrboard?retryWrites=true&w=majority

# ─── AUTHENTICATION (JWT) ─────────────────────────────────────────────────────
# Minimum 32-character secure random secret
JWT_SECRET=scholrboard_production_docker_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# ─── CORS & NETWORKING ────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173,http://localhost,http://localhost:80,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:5000/api

# ─── OPTIONAL EXTERNAL INTEGRATIONS ───────────────────────────────────────────
# Cloudinary CDN (File & proof uploads fallback to local filesystem if unset)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini AI (ATS resume analysis & recommendations fallback to mock if unset)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# Resend Email Service (Password recovery & ticket notifications)
# RESEND_API_KEY=re_your_resend_api_key
# FROM_EMAIL=noreply@scholrboard.com
# FROM_NAME=ScholrBoard
# ADMIN_CONTACT_EMAIL=admin@scholrboard.com
