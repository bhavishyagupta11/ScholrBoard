PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/scholrboard
MONGODB_URI_TEST=mongodb://localhost:27017/scholrboard_test
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000/api
REQUEST_LOG_LEVEL=verbose

# Optional — only if using Cloudinary uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional — only if AI routes are enabled
# GEMINI_API_KEY=

# Email Service (Resend HTTPS API) — required for password recovery, contact form, and ticket notifications
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@bullishpath.com
FROM_NAME=ScholrBoard
# ADMIN_CONTACT_EMAIL=admin@yourdomain.com
